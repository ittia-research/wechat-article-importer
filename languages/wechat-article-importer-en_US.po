msgstr "Partial server response: %s"

#: wechat-article-importer.php:85 wechat-article-importer.php:348
msgid "Start Import"
msgstr "Start Import"

#: wechat-article-importer.php:324
msgid ""
"Paste a WeChat Official Account article link to fetch the title, content, "
"cover image, and inline images automatically, then save the result as a "
"WordPress draft."
msgstr "Paste a WeChat Official Account article link to fetch the title, content, cover image, and inline images automatically, then save the result as a WordPress draft."

#: wechat-article-importer.php:325
msgid ""
"Imported content is converted into WordPress-stable HTML: layout-critical "
"inline styles are preserved, while WeChat editor markers, empty attributes, "
"and unstable placeholder elements are removed."
msgstr "Imported content is converted into WordPress-stable HTML: layout-critical inline styles are preserved, while WeChat editor markers, empty attributes, and unstable placeholder elements are removed."

#: wechat-article-importer.php:331
msgid "Article URL"
msgstr "Article URL"

#: wechat-article-importer.php:332
msgid "Paste the full https://mp.weixin.qq.com/... link"
msgstr "Paste the full https://mp.weixin.qq.com/... link"

#: wechat-article-importer.php:335
msgid "Import options"
msgstr "Import options"

#: wechat-article-importer.php:340
msgid "Generate thumbnails for imported images"
msgstr "Generate thumbnails for imported images"

#: wechat-article-importer.php:342
msgid ""
"Recommended. Disable this only if your server is slow or fails while "
"importing articles with very large images."
msgstr "Recommended. Disable this only if your server is slow or fails while importing articles with very large images."

#: wechat-article-importer.php:360 wechat-article-importer.php:410
#: wechat-article-importer.php:463
msgid "Insufficient permissions."
msgstr "Insufficient permissions."

#: wechat-article-importer.php:364 wechat-article-importer.php:509
msgid "Article URL cannot be empty."
msgstr "Article URL cannot be empty."

#: wechat-article-importer.php:367 wechat-article-importer.php:512
#: wechat-article-importer.php:578
msgid ""
"Only WeChat Official Account article links from https://mp.weixin.qq.com/ "
