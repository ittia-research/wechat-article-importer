msgstr "Could not parse the article content. The link may be invalid or the WeChat page structure may have changed."

#: wechat-article-importer.php:401
msgid "Article parsed successfully. Preparing to download images..."
msgstr "Article parsed successfully. Preparing to download images..."

#: wechat-article-importer.php:418
msgid "Task ID or image URL is invalid."
msgstr "Task ID or image URL is invalid."

#: wechat-article-importer.php:423 wechat-article-importer.php:472
