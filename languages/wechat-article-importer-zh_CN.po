#: wechat-article-importer.php:39 wechat-article-importer.php:323
msgid "WeChat Article Importer"
msgstr "微信文章导入器"

#: wechat-article-importer.php:40
msgid "Import WeChat"
msgstr "导入微信"

#: wechat-article-importer.php:60
msgid "Please enter a valid WeChat article URL."
msgstr "请输入有效的微信文章链接。"

#: wechat-article-importer.php:61
msgid "Parsing article..."
msgstr "正在解析文章..."

#: wechat-article-importer.php:62
msgid "Step 1/3: Parsing the article structure. Please wait..."
msgstr "步骤 1/3：正在解析文章结构，请稍候..."

#: wechat-article-importer.php:63
msgid "Failed to parse the article."
msgstr "解析文章失败。"

#: wechat-article-importer.php:64
msgid "A server error occurred while parsing the article."
msgstr "解析文章时发生服务器错误。"

#: wechat-article-importer.php:65
msgid "Download and process image"
msgstr "下载并处理图片"

#: wechat-article-importer.php:66
msgid "Fast image download"
msgstr "正在快速下载图片"

#. translators: 1: Image processing status, 2: Progress count, for example "1 / 5".
#: wechat-article-importer.php:68
#, php-format
msgid "%1$s (%2$s)"
msgstr "%1$s（%2$s）"

#. translators: 1: Image processing status, 2: Progress count, for example "1 / 5".
#: wechat-article-importer.php:70
#, php-format
msgid "Step 2/3: %1$s %2$s. Please keep this page open..."
msgstr "步骤 2/3：%1$s %2$s，请保持页面开启..."

#: wechat-article-importer.php:71
msgid ""
"A serious server error occurred while downloading images. The import has "
"been stopped."
msgstr "下载图片时发生严重服务器错误，导入已中止。"

#: wechat-article-importer.php:72
msgid "Creating post..."
msgstr "正在生成文章..."

#: wechat-article-importer.php:73
msgid "Step 3/3: Images are processed. Finalizing and creating the post..."
msgstr "步骤 3/3：图片处理完成，正在最后整理并生成文章..."

#. translators: %s: Linked "View or edit it here" text.
#: wechat-article-importer.php:75
#, php-format
msgid "The article was imported as a draft. %s"
msgstr "文章已成功导入为草稿。%s"

#: wechat-article-importer.php:76
msgid "View or edit it here"
msgstr "点击这里查看或编辑"

#: wechat-article-importer.php:77
msgid "Failed to create the post."
msgstr "生成文章失败。"

#: wechat-article-importer.php:78
msgid "A server error occurred while creating the post."
msgstr "生成文章时发生服务器错误。"

#. translators: %s: Import error message.
#: wechat-article-importer.php:80
#, php-format
msgid "Import failed: %s"
msgstr "导入失败：%s"

#. translators: %s: Server debug details.
#: wechat-article-importer.php:82
#, php-format
msgid "Server debug information: %s"
msgstr "服务器调试信息：%s"

#. translators: %s: Partial raw server response text.
#: wechat-article-importer.php:84
#, php-format
msgid "Partial server response: %s"
msgstr "服务器响应（部分）：%s"

#: wechat-article-importer.php:85 wechat-article-importer.php:348
msgid "Start Import"
msgstr "开始导入"

#: wechat-article-importer.php:324
msgid ""
"Paste a WeChat Official Account article link to fetch the title, content, "
"cover image, and inline images automatically, then save the result as a "
"WordPress draft."
msgstr "粘贴微信公众号文章链接，自动抓取标题、内容、封面图及文章内图片，并保存为 WordPress 草稿。"

#: wechat-article-importer.php:325
msgid ""
"Imported content is converted into WordPress-stable HTML: layout-critical "
"inline styles are preserved, while WeChat editor markers, empty attributes, "
"and unstable placeholder elements are removed."
msgstr "导入内容会转换为 WordPress 编辑器更稳定的 HTML：保留内联样式和版式，移除微信编辑器内部标记、空属性和无法稳定编辑的占位元素。"

#: wechat-article-importer.php:331
msgid "Article URL"
msgstr "文章链接"

#: wechat-article-importer.php:332
msgid "Paste the full https://mp.weixin.qq.com/... link"
msgstr "请粘贴完整的 https://mp.weixin.qq.com/... 链接"

#: wechat-article-importer.php:335
msgid "Import options"
msgstr "导入选项"

#: wechat-article-importer.php:340
msgid "Generate thumbnails for imported images"
msgstr "为导入的图片生成缩略图"

#: wechat-article-importer.php:342
msgid ""
"Recommended. Disable this only if your server is slow or fails while "
"importing articles with very large images."
msgstr "建议开启。如果您的服务器性能较差，或在导入超大图片的文章时卡死/失败，请取消勾选此项。"

#: wechat-article-importer.php:360 wechat-article-importer.php:410
#: wechat-article-importer.php:463
msgid "Insufficient permissions."
msgstr "权限不足。"

#: wechat-article-importer.php:364 wechat-article-importer.php:509
msgid "Article URL cannot be empty."
msgstr "文章链接不能为空。"

#: wechat-article-importer.php:367 wechat-article-importer.php:512
#: wechat-article-importer.php:578
msgid ""
"Only WeChat Official Account article links from https://mp.weixin.qq.com/ "
"are supported."
msgstr "仅支持 https://mp.weixin.qq.com/ 的微信公众号文章链接。"

#: wechat-article-importer.php:381 wechat-article-importer.php:525
msgid ""
"Could not parse the article content. The link may be invalid or the WeChat "
"page structure may have changed."
msgstr "无法解析文章正文，可能链接已失效或微信页面结构已变化。"

#: wechat-article-importer.php:401
msgid "Article parsed successfully. Preparing to download images..."
msgstr "文章解析成功，准备下载图片..."

#: wechat-article-importer.php:418
msgid "Task ID or image URL is invalid."
msgstr "任务 ID 或图片 URL 无效。"

#: wechat-article-importer.php:423 wechat-article-importer.php:472
msgid "The task has expired or does not exist."
msgstr "任务已过期或不存在。"

#: wechat-article-importer.php:427
msgid ""
"The image URL does not belong to the current import task or is not from an "
"allowed WeChat image domain."
msgstr "图片 URL 不属于当前导入任务或不在允许的微信图片域名内。"

#. translators: %s: Image download error message.
#: wechat-article-importer.php:440
#, php-format
msgid "Image download failed: %s"
msgstr "图片下载失败：%s"

#: wechat-article-importer.php:467
msgid "Task ID is invalid."
msgstr "任务 ID 无效。"

#. translators: %s: Post creation error message.
#: wechat-article-importer.php:483
#, php-format
msgid "Failed to create the post: %s"
msgstr "创建文章失败：%s"

#. translators: %s: HTTP or cURL error message.
#: wechat-article-importer.php:607
#, php-format
msgid ""
"Could not fetch article content. The link may be invalid or the server may "
"have a network problem. %s"
msgstr "无法获取文章内容，可能链接已失效或服务器网络问题。%s"

#. translators: %s: Current date and time.
#: wechat-article-importer.php:633
#, php-format
msgid "Untitled - %s"
msgstr "未命名标题 - %s"

#: wechat-article-importer.php:1533
msgid "Image URL cannot be empty."
msgstr "图片链接为空。"

#: wechat-article-importer.php:1536
msgid "The image URL is not from an allowed WeChat image domain."
msgstr "图片链接不在允许的微信图片域名内。"

#. translators: %s: HTTP or cURL error message.
#: wechat-article-importer.php:1584
#, php-format
msgid "cURL image download failed. %s"
msgstr "cURL 图片下载失败。%s"

#: wechat-article-importer.php:1587
msgid "The image file exceeds the allowed size."
msgstr "图片文件超过允许大小。"

#: wechat-article-importer.php:1593
msgid "The image format is unsupported or cannot be verified."
msgstr "不支持或无法验证的图片格式。"

#: wechat-article-importer.php:1615
msgid "Could not write image data to the file."
msgstr "无法将图片数据写入文件。"

#: wechat-article-importer.php:1621
msgid "The image extension does not match the detected file type."
msgstr "图片扩展名与实际类型不匹配。"
